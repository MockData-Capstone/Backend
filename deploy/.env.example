# 서버(EC2)의 Backend/deploy/.env 로 복사해서 채운다. 커밋 금지 (.gitignore 대상).
# 값에 따옴표를 붙이지 않는다.

# ---- 배포 설정 (docker-compose.yml이 읽는다) ----
# 서버 도메인 (예: DuckDNS). Caddy가 이 도메인으로 HTTPS 인증서를 자동으로 받는다.
DOMAIN=zipfit.duckdns.org
# TURN 공유 비밀값. 서버에서 openssl rand -hex 32 로 만든다.
TURN_SECRET=

# ---- 앱 설정 (Spring이 읽는다. 키 설명은 src/main/resources/application.properties 맨 위 주석) ----
# PUBLIC_BASE_URL, WEBRTC_TURN_URLS, WEBRTC_TURN_SECRET은 docker-compose.yml이 DOMAIN·TURN_SECRET으로 채운다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 로컬 .env와 다른 값으로 새로 만든다: openssl rand -base64 48
JWT_SECRET=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=

# 프론트 주소. 프론트가 아직 로컬(localhost:5173)에서 이 서버를 부르면 그대로 두고,
# 프론트를 배포하면 그 주소로 바꾼다 (쉼표로 여러 개 가능: CORS_ALLOWED_ORIGINS).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback

# 프론트와 서버 주소가 다르므로 재발급 토큰 쿠키를 SameSite=None + Secure로 보낸다 (HTTPS 필수).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
