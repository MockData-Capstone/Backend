# 서버(EC2)의 Backend/deploy/.env 로 복사해서 채운다. 커밋 금지 (.gitignore 대상).
# 값에 따옴표를 붙이지 않는다.

# ---- 배포 설정 (docker-compose.yml이 읽는다) ----
# 서버 도메인 (예: DuckDNS). Caddy가 이 도메인으로 HTTPS 인증서를 자동으로 받는다.
DOMAIN=zipfit.duckdns.org
# TURN 공유 비밀값. 서버에서 openssl rand -hex 32 로 만든다.
TURN_SECRET=

# 배포할 백엔드 이미지 태그 (브랜치 이름). deploy.sh가 적는다.
APP_TAG=develop

# ---- 앱 설정 (Spring이 읽는다. 키 설명은 src/main/resources/application.properties 맨 위 주석) ----
# PUBLIC_BASE_URL, WEBRTC_TURN_URLS, WEBRTC_TURN_SECRET은 docker-compose.yml이 DOMAIN·TURN_SECRET으로 채운다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 로컬 .env와 다른 값으로 새로 만든다: openssl rand -base64 48
JWT_SECRET=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
# AI 서버 (Tailscale 주소, 끝에 / 없이). 비우면 가짜 응답(FakeAiClient). README 7번
AI_BASE_URL=

# 일조 추정 (브이월드 건물정보). VWORLD_DOMAIN은 인증키에 등록한 서비스 URL과 같아야 한다.
VWORLD_API_KEY=
VWORLD_DOMAIN=zipfit.duckdns.org

# FRONTEND_URL, CORS_ALLOWED_ORIGINS, KAKAO_REDIRECT_URI, GOOGLE_REDIRECT_URI는
# 프론트를 같은 주소로 서비스하므로 docker-compose.yml이 DOMAIN으로 채운다.
# 카카오 디벨로퍼스에 https://<DOMAIN>/oauth/kakao/callback (Redirect URI)과 https://<DOMAIN> (Web 도메인)을 등록한다.

# 로컬 프론트(localhost:5173)에서 이 서버를 부를 때도 쿠키가 가도록 SameSite=None + Secure로 보낸다 (HTTPS 필수).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None

# ---- 프론트 빌드 설정 (deploy-frontend.sh가 읽는다) ----
# 카카오 디벨로퍼스 > 앱 키 > JavaScript 키. 브라우저 코드에 들어가는 값이라 비밀은 아니다 (등록한 도메인에서만 동작).
VITE_KAKAO_JS_KEY=
