# DOMAIN(.env) 하나로 백엔드와 프론트를 함께 서비스한다. 인증서는 Caddy가 자동으로 받고 갱신한다.
# 같은 주소라 재발급 토큰 쿠키가 제3자 쿠키가 되지 않는다 (iOS Safari에서도 로그인이 유지된다).
{$DOMAIN} {
	encode gzip

	# 백엔드: API, WebSocket, 업로드 파일
	@backend path /api/* /ws/* /uploads/*
	handle @backend {
		reverse_proxy app:8080
	}

	# 프론트: deploy-frontend.sh가 빌드해 둔 current(~/frontend/current)를 서비스한다.
	handle {
		root * /srv/frontend/current
		# 파일 이름에 해시가 붙는 빌드 결과는 오래 캐시하고, index.html은 매번 새로 확인한다 (새 배포가 바로 보이게).
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		# React Router 경로(/workspaces/1 등)를 새로고침해도 404가 나지 않게 index.html로 돌린다.
		try_files {path} /index.html
		file_server
	}
}
