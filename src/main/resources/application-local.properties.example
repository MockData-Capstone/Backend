# 이 파일을 application-local.properties로 복사해 값을 채운다. (application-local.properties는 .gitignore 대상)

# 32바이트 이상 랜덤 문자열. 예: openssl rand -base64 48
jwt.secret=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
oauth.kakao.client-id=
# 카카오 로그인 > 보안 > Client Secret 을 켰을 때만 (켜져 있는데 비우면 KOE010)
oauth.kakao.client-secret=
# 앱 키 > Admin 키 (탈퇴 시 연결 끊기용, 비워도 됨)
oauth.kakao.admin-key=
oauth.kakao.redirect-uri=http://localhost:5173/oauth/kakao/callback

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
oauth.google.client-id=
oauth.google.client-secret=
oauth.google.redirect-uri=http://localhost:5173/oauth/google/callback

# DB: 로컬은 H2 인메모리 (서버를 끄면 데이터가 사라진다). PostgreSQL로 바꿀 때는 이 4줄을 지우면 된다.
spring.datasource.url=jdbc:h2:mem:zipfit;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
spring.datasource.username=sa
spring.datasource.password=
spring.datasource.driver-class-name=org.h2.Driver

# 메일 (AUTH-07 비밀번호 재설정). 비워 두면 메일 대신 서버 로그에 재설정 링크가 찍힌다.
# Gmail 예시: 구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 발급 후 사용
#spring.mail.host=smtp.gmail.com
#spring.mail.port=587
#spring.mail.username=
#spring.mail.password=
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true
#app.mail.from=
